# Flask
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=your-jwt-secret-here-generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRES=3600

# Database (Neon PostgreSQL + schema tfg)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&options=-csearch_path%3Dtfg

# CORS (frontend URL)
CORS_ORIGINS=https://portfolio-edu444477.vercel.app,http://localhost:5173

# Redis (Upstash)
REDIS_URL=redis://default:token@endpoint.upstash.io:6379

# SQLAlchemy debug
SQLALCHEMY_ECHO=False