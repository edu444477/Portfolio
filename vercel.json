{
  "$schema": "https://opencode.ai/vercel.json",
  "framework": null,
  "installCommand": "cd portfolio-frontend && npm install --no-audit --no-fund",
  "buildCommand": "cd portfolio-frontend && npm run build",
  "outputDirectory": "portfolio-frontend/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
