---
import { t, type Lang } from '@/lib/i18n';

interface Props {
  name: string;
  title: string;
  story: readonly string[];
  location: string;
  email: string;
  availability: string;
  skills: readonly string[];
  lang: Lang;
}
const { name, title, story, location, email, availability, skills, lang } = Astro.props;
---
<section id="sobre-mi" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8" aria-labelledby="about-title">
  <div class="mx-auto max-w-7xl">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="about-title" class="text-3xl sm:text-4xl font-bold text-dark-900 dark:text-dark-100 mb-4">
        {t('about.title', lang)}
      </h2>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white dark:bg-dark-800 rounded-2xl border border-dark-200 dark:border-dark-700 p-8">
          <h3 class="text-xl font-semibold text-dark-900 dark:text-dark-100 mb-6">{t('about.myStory', lang)}</h3>
          <div class="space-y-4 text-dark-600 dark:text-dark-400 leading-relaxed">
            {story.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white dark:bg-dark-800 rounded-2xl border border-dark-200 dark:border-dark-700 p-6">
          <h3 class="text-lg font-semibold text-dark-900 dark:text-dark-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{t('about.profile', lang)}</span>
          </h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-dark-500 dark:text-dark-400">{t('about.name', lang)}</dt>
              <dd class="font-medium text-dark-900 dark:text-dark-100">{name}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-dark-500 dark:text-dark-400">{t('about.role', lang)}</dt>
              <dd class="font-medium text-dark-900 dark:text-dark-100">{title}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-dark-500 dark:text-dark-400">{t('about.location', lang)}</dt>
              <dd class="font-medium text-dark-900 dark:text-dark-100">{location}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-dark-500 dark:text-dark-400">{t('about.availability', lang)}</dt>
              <dd class="font-medium text-green-600 dark:text-green-400">{availability}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-dark-500 dark:text-dark-400">{t('about.email', lang)}</dt>
              <dd class="font-medium text-dark-900 dark:text-dark-100"><a href={`mailto:${email}`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{email}</a></dd>
            </div>
          </dl>
        </div>

        <div class="bg-white dark:bg-dark-800 rounded-2xl border border-dark-200 dark:border-dark-700 p-6">
          <h3 class="text-lg font-semibold text-dark-900 dark:text-dark-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            <span>{t('about.skills', lang)}</span>
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.slice(0, 10).map((skill) => (
              <span key={skill} class="px-3 py-1 text-sm font-medium rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 border border-primary-200 dark:border-primary-800">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>