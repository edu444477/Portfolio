---
import { EnvelopeIcon, MapPinIcon, ClockIcon } from '@heroicons/react/24/outline';
import { GithubIcon, LinkedInIcon } from '@/components/ui/BrandIcons';
import { Card, CardContent, Input, Textarea, Button } from '@/components/ui';
---
<section id="contacto" className="py-20 sm:py-28 px-4 sm:px-6 lg:px-8" aria-labelledby="contact-title">
  <div className="mx-auto max-w-7xl">
    <header className="text-center max-w-3xl mx-auto mb-16">
      <h2 id="contact-title" className="text-3xl sm:text-4xl font-bold text-dark-900 dark:text-dark-100 mb-4">
        <span className="text-primary-600 dark:text-primary-400">Contacta</span> conmigo
      </h2>
      <p className="text-lg text-dark-600 dark:text-dark-400">
        ¿Tienes un proyecto en mente? ¿Quieres colaborar? ¿Solo saludar? Escríbeme.
      </p>
    </header>

    <div className="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div className="space-y-6">
        <Card variant="bordered" padding="lg">
          <CardContent>
            <h3 className="text-xl font-semibold text-dark-900 dark:text-dark-100 mb-6">Información de contacto</h3>
            <div className="space-y-4">
              <a href="mailto:edu@example.com" className="flex items-center gap-4 p-4 rounded-xl bg-dark-50 dark:bg-dark-800 hover:bg-dark-100 dark:hover:bg-dark-700 transition-colors group">
                <div className="p-3 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 group-hover:scale-110 transition-transform">
                  <EnvelopeIcon className="w-6 h-6" aria-hidden="true" />
                </div>
                <div>
                  <p className="text-sm text-dark-500 dark:text-dark-400">Email</p>
                  <p className="font-medium text-dark-900 dark:text-dark-100">edu@example.com</p>
                </div>
              </a>
              <a href="https://github.com/edu444477" target="_blank" rel="noopener noreferrer" className="flex items-center gap-4 p-4 rounded-xl bg-dark-50 dark:bg-dark-800 hover:bg-dark-100 dark:hover:bg-dark-700 transition-colors group">
                <div className="p-3 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 group-hover:scale-110 transition-transform">
                  <GithubIcon className="w-6 h-6" aria-hidden="true" />
                </div>
                <div>
                  <p className="text-sm text-dark-500 dark:text-dark-400">GitHub</p>
                  <p className="font-medium text-dark-900 dark:text-dark-100">github.com/edu444477</p>
                </div>
              </a>
              <a href="https://linkedin.com/in/edu444477" target="_blank" rel="noopener noreferrer" className="flex items-center gap-4 p-4 rounded-xl bg-dark-50 dark:bg-dark-800 hover:bg-dark-100 dark:hover:bg-dark-700 transition-colors group">
                <div className="p-3 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 group-hover:scale-110 transition-transform">
                  <LinkedInIcon className="w-6 h-6" aria-hidden="true" />
                </div>
                <div>
                  <p className="text-sm text-dark-500 dark:text-dark-400">LinkedIn</p>
                  <p className="font-medium text-dark-900 dark:text-dark-100">linkedin.com/in/edu444477</p>
                </div>
              </a>
              <div className="flex items-center gap-4 p-4 rounded-xl bg-dark-50 dark:bg-dark-800">
                <div className="p-3 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                  <MapPinIcon className="w-6 h-6" aria-hidden="true" />
                </div>
                <div>
                  <p className="text-sm text-dark-500 dark:text-dark-400">Ubicación</p>
                  <p className="font-medium text-dark-900 dark:text-dark-100">Málaga, España</p>
                </div>
              </div>
              <div className="flex items-center gap-4 p-4 rounded-xl bg-dark-50 dark:bg-dark-800">
                <div className="p-3 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                  <ClockIcon className="w-6 h-6" aria-hidden="true" />
                </div>
                <div>
                  <p className="text-sm text-dark-500 dark:text-dark-400">Disponibilidad</p>
                  <p className="font-medium text-green-600 dark:text-green-400">Abierto a oportunidades</p>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card variant="bordered" padding="lg">
          <CardContent>
            <h3 className="text-xl font-semibold text-dark-900 dark:text-dark-100 mb-4">Horario preferido</h3>
            <p className="text-dark-600 dark:text-dark-400">Lunes a Viernes: 9:00 - 18:00 (CET)</p>
            <p className="text-dark-600 dark:text-dark-400 mt-1">Flexible para reuniones remotas</p>
          </CardContent>
        </Card>
      </div>

      <div>
        <Card variant="elevated" padding="lg">
          <CardContent>
            <h3 className="text-xl font-semibold text-dark-900 dark:text-dark-100 mb-6">Enviar mensaje</h3>
            <form id="contact-form" className="space-y-5" action="/api/contact" method="POST">
              <Input label="Nombre" name="name" required placeholder="Tu nombre" />
              <Input label="Email" name="email" type="email" required placeholder="tu@email.com" />
              <Input label="Asunto" name="subject" required placeholder="Asunto del mensaje" />
              <Textarea label="Mensaje" name="message" required rows={5} placeholder="Cuéntame en qué puedo ayudarte..." />
              <Button type="submit" className="w-full" size="lg">
                Enviar mensaje
              </Button>
              <p className="text-xs text-center text-dark-500 dark:text-dark-400">
                Al enviar, aceptas la <a href="/privacy" className="underline hover:text-primary-600">política de privacidad</a>. Respondo en 24-48h laborables.
              </p>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    
    try {
      const formData = new FormData(form);
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData))
      });
      
      if (response.ok) {
        alert('¡Mensaje enviado! Te responderé pronto.');
        form.reset();
      } else {
        throw new Error('Error al enviar');
      }
    } catch {
      alert('Error al enviar. Intenta de nuevo o escríbeme directamente a edu@example.com');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>