---
/**
 * Grid de proyectos + enlace al detalle (RF-14 a RF-17, RFN-2).
 * Orden: primero los destacados y dentro de cada grupo por fecha
 * descendente.
 */
import { getCollection } from 'astro:content';
import { ArrowTopRightOnSquareIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
import { t, localizePath, type Lang } from '@/lib/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Project = CollectionEntry<'projects'>;

const byStartDateDesc = (a: Project, b: Project) =>
  new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();

const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured).sort(byStartDateDesc);
const others = all.filter((p) => !p.data.featured).sort(byStartDateDesc);

// RF-17: si no hay repo o demo, no se muestra el enlace.
const detailHref = (slug: string) => localizePath(`/projects/${slug}`, lang);

const STATUS_CLASS: Record<string, string> = {
  completed: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
  'in-progress': 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  planned: 'bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-300',
  archived: 'bg-dark-100 text-dark-700 dark:bg-dark-700 dark:text-dark-300',
};
---

<section id="proyectos" class="section scroll-mt-header" aria-labelledby="projects-title">
  <div class="section-container">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <h2 id="projects-title" class="section-title">{t('projects.title', lang)}</h2>
      <p class="section-lead">{t('projects.subtitle', lang)}</p>
    </header>

    {
      featured.length > 0 && (
        <ul class="mb-16 grid gap-8 lg:grid-cols-2">
          {featured.map((project) => (
            <li class="group h-full">
              <article class="flex h-full flex-col rounded-2xl border border-dark-200 bg-white p-6 shadow-sm transition-colors hover:border-primary-400 dark:border-dark-700 dark:bg-dark-800 dark:hover:border-primary-600">
                <header class="mb-4 flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <h3 class="text-2xl font-bold text-dark-900 transition-colors group-hover:text-primary-700 dark:text-dark-100 dark:group-hover:text-primary-400">
                      {project.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-dark-500 dark:text-dark-400">
                      {new Date(project.data.startDate).getFullYear()}
                    </p>
                  </div>
                  <span
                    class={`shrink-0 rounded-full px-3 py-1 text-xs font-medium ${STATUS_CLASS[project.data.status]}`}
                  >
                    {t(`projects.status.${project.data.status}`, lang)}
                  </span>
                </header>

                <p class="mb-5 leading-relaxed text-dark-600 dark:text-dark-400">
                  {project.data.description}
                </p>

                <ul class="mb-5 flex flex-wrap gap-2">
                  {project.data.techStack.slice(0, 6).map((tech) => (
                    <li class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-800 dark:bg-primary-900/30 dark:text-primary-300">
                      {tech}
                    </li>
                  ))}
                  {project.data.techStack.length > 6 && (
                    <li class="rounded-full bg-dark-100 px-3 py-1 text-xs font-medium text-dark-600 dark:bg-dark-700 dark:text-dark-300">
                      {t('projects.more', lang, { count: String(project.data.techStack.length - 6) })}
                    </li>
                  )}
                </ul>

                {project.data.challenges && project.data.challenges.length > 0 && (
                  <div class="mb-5">
                    <h4 class="mb-2 text-sm font-semibold text-dark-900 dark:text-dark-100">
                      {t('projects.challenges', lang)}
                    </h4>
                    <ul class="space-y-1.5">
                      {project.data.challenges.slice(0, 3).map((challenge) => (
                        <li class="flex gap-2 text-sm text-dark-600 dark:text-dark-400">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-500" aria-hidden="true" />
                          <span>{challenge}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <footer class="mt-auto flex items-center justify-between gap-4 pt-4">
                  <div class="flex items-center gap-4">
                    {project.data.repoUrl && (
                      <a
                        href={project.data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-sm text-dark-500 transition-colors hover:text-primary-600 dark:text-dark-400 dark:hover:text-primary-400"
                      >
                        {t('projects.code', lang)}
                        <ArrowTopRightOnSquareIcon className="h-4 w-4" aria-hidden="true" />
                      </a>
                    )}
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-sm text-dark-500 transition-colors hover:text-primary-600 dark:text-dark-400 dark:hover:text-primary-400"
                      >
                        {t('projects.demo', lang)}
                        <ArrowTopRightOnSquareIcon className="h-4 w-4" aria-hidden="true" />
                      </a>
                    )}
                  </div>
                  <a
                    href={detailHref(project.slug)}
                    class="inline-flex items-center gap-1 text-sm font-medium text-primary-700 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300"
                  >
                    {t('projects.viewDetail', lang)}
                    <ChevronRightIcon className="h-4 w-4" aria-hidden="true" />
                  </a>
                </footer>
              </article>
            </li>
          ))}
        </ul>
      )
    }

    {
      others.length > 0 && (
        <div>
          <h3 class="mb-8 text-2xl font-bold text-dark-900 dark:text-dark-100">
            {t('projects.other', lang)}
          </h3>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((project) => (
              <li class="h-full">
                <article class="flex h-full flex-col rounded-2xl border border-dark-200 bg-white p-6 shadow-sm transition-colors hover:border-primary-400 dark:border-dark-700 dark:bg-dark-800 dark:hover:border-primary-600">
                  <header class="mb-3 flex items-start justify-between gap-3">
                    <h4 class="font-semibold text-dark-900 dark:text-dark-100">{project.data.title}</h4>
                    <span
                      class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${STATUS_CLASS[project.data.status]}`}
                    >
                      {t(`projects.status.${project.data.status}`, lang)}
                    </span>
                  </header>
                  <p class="mb-4 text-sm text-dark-600 dark:text-dark-400">{project.data.shortDescription}</p>
                  <ul class="mb-4 flex flex-wrap gap-1.5">
                    {project.data.techStack.slice(0, 5).map((tech) => (
                      <li class="rounded-md bg-dark-100 px-2 py-1 text-xs font-medium text-dark-700 dark:bg-dark-700 dark:text-dark-200">
                        {tech}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={detailHref(project.slug)}
                    class="mt-auto inline-flex items-center justify-center gap-1 rounded-lg border border-dark-300 px-4 py-2 text-sm font-medium transition-colors hover:border-primary-400 hover:text-primary-700 dark:border-dark-600 dark:hover:border-primary-600 dark:hover:text-primary-400"
                  >
                    {t('projects.viewDetail', lang)}
                    <ChevronRightIcon className="h-4 w-4" aria-hidden="true" />
                  </a>
                </article>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      all.length === 0 && (
        <p class="text-center text-dark-500 dark:text-dark-400">{t('projects.empty', lang)}</p>
      )
    }
  </div>
</section>