---
/**
 * Stack tecnológico agrupado por origen (RF-20, RF-21, RF-22, RFN-2).
 *
 * RF-22: si la misma tecnología aparece en varios orígenes, solo se muestra
 * en el de mayor precedencia: cv > tfg > portfolio.
 */
import { getCollection } from 'astro:content';
import { ArrowTopRightOnSquareIcon, ArrowDownIcon } from '@heroicons/react/24/outline';
import { t, localizePath, type Lang } from '@/lib/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Tech = CollectionEntry<'tech'>;

/** Precedencia: cuanto menor el número, mayor la prioridad. */
const SOURCE_PRECEDENCE = { cv: 0, tfg: 1, portfolio: 2 } as const;

const SOURCE_ORDER = ['cv', 'tfg', 'portfolio'] as const;

const LEVEL_ORDER = ['expert', 'advanced', 'intermediate', 'beginner', 'learning'] as const;

const LEVEL_CLASS: Record<string, string> = {
  expert: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300',
  advanced: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
  intermediate: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
  beginner: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  learning: 'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300',
};

const all = await getCollection('tech');

// RF-22: deduplicar por nombre, gana el origen de mayor precedencia.
const byName = new Map<string, Tech>();
for (const tech of all) {
  const name = tech.data.name.toLowerCase();
  const current = byName.get(name);
  if (!current) {
    byName.set(name, tech);
    continue;
  }
  const currentRank = SOURCE_PRECEDENCE[current.data.source];
  const incomingRank = SOURCE_PRECEDENCE[tech.data.source];
  if (incomingRank < currentRank) byName.set(name, tech);
}

const groups = SOURCE_ORDER.map((source) => ({
  source,
  items: [...byName.values()]
    .filter((tech) => tech.data.source === source)
    .sort((a, b) => {
      const levelDiff = LEVEL_ORDER.indexOf(a.data.level) - LEVEL_ORDER.indexOf(b.data.level);
      if (levelDiff !== 0) return levelDiff;
      return a.data.name.localeCompare(b.data.name);
    }),
})).filter((group) => group.items.length > 0);

const contactHref = `${localizePath('/', lang)}#contacto`;
---

<section id="tecnologias" class="section scroll-mt-header" aria-labelledby="tech-title">
  <div class="section-container">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <h2 id="tech-title" class="section-title">{t('tech.title', lang)}</h2>
      <p class="section-lead">{t('tech.subtitle', lang)}</p>
    </header>

    {
      groups.length === 0 && (
        <p class="text-center text-dark-500 dark:text-dark-400">{t('tech.empty', lang)}</p>
      )
    }

    {
      groups.map((group) => (
        <section class="mb-14 last:mb-0" aria-labelledby={`tech-group-${group.source}`}>
          <h3
            id={`tech-group-${group.source}`}
            class="mb-2 flex items-center gap-3 border-b border-dark-200 pb-3 text-xl font-bold text-dark-900 dark:border-dark-700 dark:text-dark-100"
          >
            {t(`tech.source.${group.source}`, lang)}
            <span class="text-sm font-normal text-dark-500 dark:text-dark-400">
              ({group.items.length})
            </span>
          </h3>
          <p class="mb-6 text-sm text-dark-500 dark:text-dark-400">
            {t(`tech.sourceDesc.${group.source}`, lang)}
          </p>

          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((tech) => (
              <li class="rounded-xl border border-dark-200 bg-white p-5 transition-colors hover:border-primary-400 dark:border-dark-700 dark:bg-dark-800 dark:hover:border-primary-600">
                <div class="mb-2 flex items-start justify-between gap-3">
                  <h4 class="font-semibold text-dark-900 dark:text-dark-100">{tech.data.name}</h4>
                  <span
                    class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ${LEVEL_CLASS[tech.data.level]}`}
                  >
                    {t(`tech.level.${tech.data.level}`, lang)}
                  </span>
                </div>
                {tech.data.years && (
                  <p class="mb-2 text-sm text-dark-500 dark:text-dark-400">
                    {tech.data.years} {t(tech.data.years === 1 ? 'tech.years' : 'tech.years_plural', lang)}
                  </p>
                )}
                {tech.data.description && (
                  <p class="mb-3 text-sm text-dark-600 dark:text-dark-400">{tech.data.description}</p>
                )}
                {tech.data.link && (
                  <a
                    href={tech.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-medium text-primary-700 hover:underline dark:text-primary-400"
                  >
                    {t('tech.docs', lang)}
                    <ArrowTopRightOnSquareIcon className="h-3.5 w-3.5" aria-hidden="true" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="mt-16 rounded-2xl bg-gradient-to-r from-primary-700 to-primary-900 p-8 text-center text-white">
      <h3 class="mb-2 text-2xl font-bold">{t('tech.cta.title', lang)}</h3>
      <p class="mx-auto mb-6 max-w-2xl opacity-90">{t('tech.cta.body', lang)}</p>
      <a
        href={contactHref}
        class="inline-flex items-center gap-2 rounded-lg border-2 border-white/30 bg-white/20 px-6 py-3 font-semibold transition-colors hover:bg-white/30"
      >
        {t('hero.cta.contact', lang)}
        <ArrowDownIcon className="h-5 w-5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>