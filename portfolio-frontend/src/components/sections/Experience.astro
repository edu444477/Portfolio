---
import { getCollection } from 'astro:content';
import { BriefcaseIcon, GraduationCapIcon, CodeBracketIcon } from '@heroicons/react/24/outline';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui';
import type { ExperienceEntry } from '@/content/config';

const experiences = await getCollection('experience');
---
<section id="experiencia" className="py-20 sm:py-28 px-4 sm:px-6 lg:px-8" aria-labelledby="experience-title">
  <div className="mx-auto max-w-7xl">
    <header className="text-center max-w-3xl mx-auto mb-16">
      <h2 id="experience-title" className="text-3xl sm:text-4xl font-bold text-dark-900 dark:text-dark-100 mb-4">
        Experiencia <span className="text-primary-600 dark:text-primary-400">profesional</span>
      </h2>
      <p className="text-lg text-dark-600 dark:text-dark-400">
        Proyectos, roles y formaciones que han definido mi carrera
      </p>
    </header>

    <div className="relative">
      <div className="absolute left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary-200 via-primary-400 to-primary-200 dark:from-primary-800 dark:via-primary-600 dark:to-primary-800" aria-hidden="true" />

      <div className="space-y-8">
        {experiences.map((entry, index) => {
          const data = entry.data as ExperienceEntry;
          const isLeft = index % 2 === 0;

          const typeIcons = {
            'full-time': BriefcaseIcon,
            'part-time': BriefcaseIcon,
            'internship': BriefcaseIcon,
            'freelance': CodeBracketIcon,
            'education': GraduationCapIcon,
            'project': CodeBracketIcon,
          };
          const TypeIcon = typeIcons[data.type];

          const formatDate = (dateStr: string) => new Date(dateStr).toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });
          const endDate = data.current ? 'Actualidad' : formatDate(data.endDate!);

          return (
            <article className={`relative flex items-center gap-8 ${isLeft ? 'flex-row' : 'flex-row-reverse'}`}>
              <div className="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-primary-500 border-4 border-white dark:border-dark-900 z-10 shadow-lg" aria-hidden="true" />

              <div className={`w-1/2 pr-8 ${isLeft ? 'text-right' : 'pl-8'}`}>
                <Card variant="interactive" padding="md" className="h-full">
                  <CardHeader>
                    <div className="flex items-center gap-2 mb-2">
                      <TypeIcon className="w-5 h-5 text-primary-600 dark:text-primary-400" aria-hidden="true" />
                      <span className="text-sm font-medium text-primary-600 dark:text-primary-400 uppercase tracking-wider">
                        {data.type === 'education' ? 'Formación' : data.type === 'project' ? 'Proyecto' : 'Experiencia'}
                      </span>
                    </div>
                    <CardTitle className="text-xl">{data.role}</CardTitle>
                  </CardHeader>
                  <CardContent>
                    <div className="flex items-center gap-2 text-sm text-dark-500 dark:text-dark-400 mb-3">
                      <span className="font-medium text-dark-700 dark:text-dark-300">{data.company}</span>
                      <span>·</span>
                      <span>{data.location}</span>
                      <span>·</span>
                      <time>{formatDate(data.startDate)} – {endDate}</time>
                    </div>
                    <p className="text-dark-600 dark:text-dark-400 mb-4">{data.description}</p>

                    {data.achievements && data.achievements.length > 0 && (
                      <ul className="space-y-2 mb-4">
                        {data.achievements.map((achievement, i) => (
                          <li key={i} className="flex items-start gap-2 text-sm text-dark-600 dark:text-dark-400">
                            <svg className="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" /></svg>
                            {achievement}
                          </li>
                        ))}
                      </ul>
                    )}

                    <div className="flex flex-wrap gap-2">
                      {data.techStack.map((tech) => (
                        <span key={tech} className="px-2 py-1 text-xs font-medium rounded bg-dark-100 dark:bg-dark-700 text-dark-600 dark:text-dark-300 border border-dark-200 dark:border-dark-600">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </CardContent>
                </Card>
              </div>
            </article>
          )
        })}
      </div>
    </div>
  </div>
</section>