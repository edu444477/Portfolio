---
/**
 * Experiencia laboral + formación académica (RF-18, RF-19, RFN-2).
 *
 * OJO, dos atributos conviven en los .astro y no son intercambiables:
 *   - Elementos HTML  -> `class=`   (Astro lo lee)
 *   - Componentes React (Heroicons) -> `className=` (reciben props de React)
 * Usar `class=` en un Heroicon deja el SVG sin tamaño y se estira al 100%
 * del contenedor; usar `className=` en HTML no aplica estilo.
 */
import { getCollection } from 'astro:content';
import {
  BriefcaseIcon,
  AcademicCapIcon,
  CodeBracketIcon,
  SparklesIcon,
} from '@heroicons/react/24/outline';
import { t, type Lang } from '@/lib/i18n';
import { byLocale } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Entry = CollectionEntry<'experience'>;

const entries = byLocale(await getCollection('experience'), lang);

const isEducation = (e: Entry) => e.data.type === 'education' || e.data.type === 'project';

const jobs = entries
  .filter((e) => !isEducation(e))
  .sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime());

const education = entries
  .filter(isEducation)
  .sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime());

const TYPE_LABEL: Record<string, string> = {
  'full-time': 'nav.experiencia',
  'part-time': 'nav.experiencia',
  internship: 'nav.experiencia',
  freelance: 'nav.experiencia',
};

function formatMonth(date: string, lang: Lang): string {
  return new Date(date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
    year: 'numeric',
    month: 'short',
  });
}

function dateRange(entry: Entry, lang: Lang): string {
  const from = formatMonth(entry.data.startDate, lang);
  const to = entry.data.current ? t('experience.current', lang) : formatMonth(entry.data.endDate!, lang);
  return `${from} — ${to}`;
}
---

<section id="experiencia" class="section scroll-mt-header" aria-labelledby="experience-title">
  <div class="section-container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="experience-title" class="section-title">
        {t('experience.title', lang)}
      </h2>
      <p class="section-lead">{t('experience.subtitle', lang)}</p>
    </header>

    <ol class="relative space-y-8 md:space-y-10">
      <!-- Línea vertical del timeline, oculta en móvil -->
      <div
        class="hidden md:block absolute left-4 top-2 bottom-2 w-0.5 bg-gradient-to-b from-primary-300 via-primary-500 to-primary-300 dark:from-primary-800 dark:via-primary-600 dark:to-primary-800"
        aria-hidden="true"
      >
      </div>

      {
        jobs.map((entry) => (
          <li class="relative md:pl-16">
            <span
              class="hidden md:flex absolute left-0 top-6 h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-white ring-4 ring-white dark:ring-dark-950"
              aria-hidden="true"
            >
              <BriefcaseIcon className="h-4 w-4" />
            </span>

            <article class="rounded-2xl border border-dark-200 bg-white p-6 shadow-sm transition-colors hover:border-primary-400 dark:border-dark-700 dark:bg-dark-800 dark:hover:border-primary-600">
              <header class="mb-3">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="text-xl font-bold text-dark-900 dark:text-dark-100">
                    {entry.data.role}
                  </h3>
                  <span class="text-sm text-dark-500 dark:text-dark-400">
                    {t(TYPE_LABEL[entry.data.type], lang)}
                  </span>
                </div>
                <p class="font-medium text-primary-700 dark:text-primary-400">
                  {entry.data.company}
                </p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-dark-500 dark:text-dark-400">
                  <span>{entry.data.location}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={entry.data.startDate}>{dateRange(entry, lang)}</time>
                  {entry.data.current && (
                    <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/40 dark:text-green-300">
                      {t('experience.current', lang)}
                    </span>
                  )}
                </p>
              </header>

              <p class="mb-4 leading-relaxed text-dark-600 dark:text-dark-400">
                {entry.data.description}
              </p>

              {entry.data.achievements && entry.data.achievements.length > 0 && (
                <ul class="mb-4 space-y-2">
                  {entry.data.achievements.map((achievement) => (
                    <li class="flex gap-2 text-sm text-dark-600 dark:text-dark-400">
                      <SparklesIcon
                        className="mt-0.5 h-4 w-4 shrink-0 text-primary-500"
                        aria-hidden="true"
                      />
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}

              {entry.data.techStack.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {entry.data.techStack.map((tech) => (
                    <span class="rounded-md bg-dark-100 px-2 py-1 text-xs font-medium text-dark-700 dark:bg-dark-700 dark:text-dark-200">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </article>
          </li>
        ))
      }
    </ol>

    {
      education.length > 0 && (
        <div class="mt-20">
          <h3 class="mb-8 flex items-center gap-3 text-2xl font-bold text-dark-900 dark:text-dark-100">
            <AcademicCapIcon className="h-6 w-6 text-primary-600 dark:text-primary-400" aria-hidden="true" />
            {t('experience.education', lang)}
          </h3>

          <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {education.map((entry) => (
              <li class="rounded-2xl border border-dark-200 bg-white p-6 shadow-sm dark:border-dark-700 dark:bg-dark-800">
                <div class="mb-3 flex items-center justify-between gap-3">
                  <CodeBracketIcon className="h-5 w-5 shrink-0 text-primary-600 dark:text-primary-400" aria-hidden="true" />
                  <span class="text-xs font-medium text-dark-500 dark:text-dark-400">
                    {dateRange(entry, lang)}
                  </span>
                </div>
                <h4 class="font-semibold text-dark-900 dark:text-dark-100">
                  {entry.data.role}
                </h4>
                <p class="mt-1 text-sm text-primary-700 dark:text-primary-400">
                  {entry.data.company}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-dark-600 dark:text-dark-400">
                  {entry.data.description}
                </p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>