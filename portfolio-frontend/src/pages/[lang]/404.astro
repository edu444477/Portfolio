---
/**
 * Página 404 bilingüe (RF-7).
 */
import Layout from '@/layouts/Layout.astro';
import { t, localizePath, type Lang } from '@/lib/i18n';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'es';

const homeHref = localizePath('/', lang);
const projectsHref = `${homeHref}#proyectos`;
---

<Layout title={`404 — ${t('notfound.title', lang)}`} description={t('notfound.message', lang)} lang={lang}>
  <section class="section scroll-mt-header flex min-h-[70vh] items-center">
    <div class="section-container max-w-2xl text-center">
      <p class="mb-4 text-7xl font-bold text-primary-600 dark:text-primary-400">404</p>
      <h1 class="mb-4 text-3xl font-bold text-dark-900 dark:text-dark-100 sm:text-4xl">
        {t('notfound.title', lang)}
      </h1>
      <p class="mb-10 text-lg text-dark-600 dark:text-dark-400">{t('notfound.message', lang)}</p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={homeHref}
          class="rounded-lg bg-primary-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-700"
        >
          {t('notfound.home', lang)}
        </a>
        <a
          href={projectsHref}
          class="rounded-lg border-2 border-dark-300 px-6 py-3 font-semibold transition-colors hover:border-primary-400 hover:text-primary-700 dark:border-dark-600 dark:hover:border-primary-600 dark:hover:text-primary-400"
        >
          {t('notfound.projects', lang)}
        </a>
      </div>
    </div>
  </section>
</Layout>