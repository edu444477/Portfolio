---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/layout/Hero';
import About from '@/components/sections/About.astro';
import Experience from '@/components/sections/Experience.astro';
import Projects from '@/components/sections/Projects.astro';
import TechStack from '@/components/sections/TechStack.astro';
import Contact from '@/components/sections/Contact.astro';
import { IDENTITY, localize } from '@/lib/constants';
import type { Lang } from '@/lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

// Los params de ruta NO llegan por Astro.props: leerlos de Astro.params.
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'es';

const role = localize(IDENTITY.role, lang);
const bio = localize(IDENTITY.bio, lang);
const title = `${IDENTITY.name} — ${role}`;
const description = bio;
---

<Layout title={title} description={description} lang={lang}>
  <Hero
    name={IDENTITY.name}
    title={role}
    description={bio}
    ctaHref="#proyectos"
    secondaryCtaHref="#contacto"
    lang={lang}
  />
  <About
    name={IDENTITY.name}
    title={role}
    story={IDENTITY.story[lang]}
    location={localize(IDENTITY.location, lang)}
    email={IDENTITY.email}
    availability={localize(IDENTITY.availability, lang)}
    skills={IDENTITY.skills}
    lang={lang}
  />
  <Experience />
  <Projects />
  <TechStack />
  <Contact />
</Layout>

<script>
  // ThemeToggle y LanguageToggle se hidratan automáticamente vía client:visible
</script>