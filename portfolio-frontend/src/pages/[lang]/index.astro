---
/**
 * Home bilingüe. Reúne las seis secciones en el orden que fija RF-1.
 */
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/layout/Hero';
import About from '@/components/sections/About.astro';
import Experience from '@/components/sections/Experience.astro';
import Projects from '@/components/sections/Projects.astro';
import TechStack from '@/components/sections/TechStack.astro';
import Contact from '@/components/sections/Contact.astro';
import { IDENTITY, localize } from '@/lib/constants';
import { getSlug, type Lang } from '@/lib/i18n';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

// Los params de ruta NO llegan por Astro.props: leerlos de Astro.params.
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'es';

const role = localize(IDENTITY.role, lang);
const bio = localize(IDENTITY.bio, lang);
---

<Layout title={`${IDENTITY.name} — ${role}`} description={bio} lang={lang}>
  <Hero
    name={IDENTITY.name}
    title={role}
    description={bio}
    ctaHref={`#${getSlug('proyectos', lang)}`}
    secondaryCtaHref={`#${getSlug('contacto', lang)}`}
    lang={lang}
  />
  <About
    name={IDENTITY.name}
    title={role}
    story={IDENTITY.story[lang]}
    location={localize(IDENTITY.location, lang)}
    email={IDENTITY.email}
    availability={localize(IDENTITY.availability, lang)}
    skills={IDENTITY.skills}
    lang={lang}
  />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <TechStack lang={lang} />
  <Contact lang={lang} />
</Layout>